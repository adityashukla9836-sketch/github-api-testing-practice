    {
      "name": "Check Rate - Limit",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Rate limit header exists\", function () {\r\n    pm.expect(pm.response.headers.has(\"X-RateLimit-Limit\")).to.be.true;\r\n});\r\n\r\npm.test(\"Remaining calls is a valid number\", function () {\r\n    const remaining = Number(pm.response.headers.get(\"X-RateLimit-Remaining\"));\r\n    pm.expect(remaining).to.be.a(\"number\");\r\n    pm.expect(remaining).to.be.at.least(0);\r\n});"
            ]
          }
        }
